# ┌────────────────────────────┐
# │ 🔑 Discord Configuration   │
# └────────────────────────────┘
DISCORD_BOT_TOKEN=your-discord-bot-token-here
ANNOUNCEMENT_CHANNEL_ID=123456789012345678  # Replace with your channel ID


# ┌────────────────────────────┐
# │ 🧠 OpenAI Integration       │
# └────────────────────────────┘
OPENAI_API_KEY=your-openai-api-key-here
AI_TOGGLE=true # Set to false to disable AI greetings and images
# Model for shortening event titles (used whenever OPENAI_API_KEY is set)
# OPENAI_TITLE_MODEL=gpt-5.4-nano


# ┌────────────────────────────┐
# │ 📆 Calendar Sources         │
# │ Format: google:calendarId:TAG or ics:url:TAG
# └────────────────────────────┘
CALENDAR_SOURCES=google:your-google-calendar-id:T,google:another-calendar-id:B


# ┌────────────────────────────┐
# │ 👥 Discord User ↔ Tag Map   │
# │ Format: discord_user_id:TAG (comma-separated)
# └────────────────────────────┘
USER_TAG_MAPPING=123456789012345678:T,987654321098765432:B


# ┌────────────────────────────┐
# │ 🔐 Google Credentials Path │
# └────────────────────────────┘
GOOGLE_APPLICATION_CREDENTIALS=/app/service_account.json


# ┌────────────────────────────┐
# │ ⚙️  Debug Mode (optional)   │
# └────────────────────────────┘
DEBUG=false
